@page "/command-stream"
@rendermode InteractiveWebAssembly
@implements IDisposable
@using SmartX.Gateway.Shared.DataStructures
@using SmartX.Gateway.Shared.Models
@using SmartX.Gateway.Shared.Services
@using SmartX.Gateway.Client.Components
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Smart-X | Command Stream</PageTitle>

<div class="section">
    <div>
        <h1>Command Stream</h1>
        <div class="filter-chips">
            @if (_isDisconnected)
            {
                <span class="mono-label critical-text">Disconnected - retrying</span>
            }
            else if (_isLoading)
            {
                <span class="mono-label">Connecting</span>
            }
            else
            {
                <span class="mono-label accent-text"><span class="nav-active-dot" aria-hidden="true"></span>Live</span>
            }
            <span class="mono-label">@(_sensors?.Count ?? 0) sensors</span>
            <span class="mono-label">Polling every 3s</span>
        </div>
        @if (_isDisconnected)
        {
            <p class="connection-banner" role="alert">
                @if (_lastSuccessUtc is DateTime lastSuccess)
                {
                    <text>Disconnected - retrying every 3 seconds. Showing data from the last successful update at @TimeDisplay.Clock(lastSuccess).</text>
                }
                else
                {
                    <text>Disconnected - retrying every 3 seconds. The gateway has not answered yet; check that it is running.</text>
                }
            </p>
        }
    </div>

    @if (!_isLoading && _lastSuccessUtc is not null)
    {
        <HealthSummaryBar Sensors="@(_sensors ?? new())" ConnectionIssues="_connectionIssues" />
    }
    <StatusLegend />

    <div class="command-layout @(_panelsEntered ? "panels-entered" : "")">
        @if (_isLoading)
        {
            <TelemetryFeed Sensors="@(_sensors ?? new())" NewReadingIds="_newReadingIds" IsLoading="_isLoading" />

            <div class="command-panel" aria-busy="true">
                <header class="panel-header">
                    <h3>Manual Override</h3>
                    <span class="mono-label">Waiting</span>
                </header>
                <div class="empty-state" role="status">Loading devices...</div>
            </div>

            <div class="alerts-panel" aria-busy="true">
                <header class="panel-header">
                    <h3>Active Alerts</h3>
                    <span class="mono-label">--</span>
                </header>
                <div class="empty-state" role="status">Reading alert set...</div>
            </div>

            <div class="insights-panel" aria-busy="true">
                <header class="panel-header">
                    <h3>Automated Insights</h3>
                    <span class="mono-label">--</span>
                </header>
                <div class="empty-state" role="status">Loading insights...</div>
            </div>
        }
        else if (_lastSuccessUtc is null)
        {
            <div class="feed-panel">
                <header class="panel-header">
                    <h3>Incoming Telemetry</h3>
                    <span class="mono-label critical-text">No signal</span>
                </header>
                <div class="empty-state">Gateway unreachable. Readings appear here automatically as soon as it responds. If this persists, check that the gateway is running.</div>
            </div>

            <CommandPanel @ref="_commandPanel" Sensors="@(_sensors ?? new())" ActiveAlertIds="_activeAlertIds" CommandHistory="_commandHistory"
                          @bind-SelectedSensorId="_selectedSensorId" OnCommandIssued="RefreshAsync" />

            <div class="alerts-panel">
                <header class="panel-header">
                    <h3>Active Alerts</h3>
                    <span class="mono-label">--</span>
                </header>
                <div class="empty-state">Alert state cannot be confirmed while the gateway is offline. Alerts reload with the next successful update.</div>
            </div>

            <div class="insights-panel">
                <header class="panel-header">
                    <h3>Automated Insights</h3>
                    <span class="mono-label">--</span>
                </header>
                <div class="empty-state">Insights unavailable. Suggestions reload with the next successful update.</div>
            </div>
        }
        else
        {
            <TelemetryFeed Sensors="@(_feedSensors ?? new())" NewReadingIds="_newReadingIds" IsLoading="_isLoading"
                           IsPaused="_feedPaused" PendingCount="_pendingCount" OnTogglePause="ToggleFeedPause" />
            <CommandPanel @ref="_commandPanel" Sensors="@(_sensors ?? new())" ActiveAlertIds="_activeAlertIds" CommandHistory="_commandHistory"
                          @bind-SelectedSensorId="_selectedSensorId" OnCommandIssued="RefreshAsync" />
            <AlertsPanel Sensors="@(_sensors ?? new())" AlertDetails="_alertDetails" OnAlertResolved="RefreshAsync" OnSendCommand="SelectDevice" />
            <InsightsPanel Insights="@(_insights ?? new())" Sensors="@(_sensors ?? new())" OnCommandIssued="RefreshAsync" OnSelectDevice="SelectDevice" />
        }
    </div>
</div>

@code {
    private List<SensorProfile>? _sensors;
    private List<ActionInsight>? _insights;
    private List<AlertDetail> _alertDetails = new();
    private List<ManualCommand> _commandHistory = new();
    private HashSet<Guid> _activeAlertIds = new();
    private const int FeedReadingsPerSensor = 20;

    private List<string> _connectionIssues = new();
    private System.Threading.Timer? _pollTimer;
    private bool _isRefreshing;
    private bool _refreshQueued;
    private bool _isLoading = true;
    private bool _isDisconnected;
    private DateTime? _lastSuccessUtc;

    // The feed shows its own snapshot so it can be paused while everything else keeps updating.
    private List<SensorProfile>? _feedSensors;
    private HashSet<string> _displayedReadingIds = new();
    private readonly HashSet<string> _newReadingIds = new();
    private bool _feedPaused;
    private int _pendingCount;

    private Guid? _selectedSensorId;
    private CommandPanel? _commandPanel;
    private bool _focusCommandPanel;

    // Pre-rendered HTML gets no interactive render to add the class, so it must ship visible.
    private bool _panelsEntered = !OperatingSystem.IsBrowser();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        await LoadAsync();
        _isLoading = false;

        // command-stream?device=<sensorId> (from the Topology page) preselects that device in Manual Override.
        if (DeviceFromQuery() is Guid deviceId && (_sensors?.Any(s => s.Id == deviceId) ?? false))
        {
            SelectDevice(deviceId);
        }

        // OnInitializedAsync also runs during server pre-render; polling only makes sense in the live WASM instance.
        if (OperatingSystem.IsBrowser())
        {
            _pollTimer = new System.Threading.Timer(async _ => await PollAsync(), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCommandPanel && _commandPanel is not null)
        {
            _focusCommandPanel = false;
            await _commandPanel.FocusDeviceSelectAsync();
        }

        if (!firstRender)
        {
            _newReadingIds.Clear();
            return;
        }

        if (_panelsEntered)
        {
            return;
        }

        // The panels have to paint once in their hidden state before the class lands, otherwise the transition is skipped.
        await Task.Delay(50);
        _panelsEntered = true;
        StateHasChanged();
    }

    private async Task PollAsync()
    {
        await RefreshAsync();

        // A tick already in flight when the component is disposed must not render into a torn-down component.
        if (_pollTimer is not null)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    // A command, acknowledgement or undo that finishes while a poll is in flight queues one more refresh straight after it,
    // so its result is never hidden behind data fetched before it happened. Public so tests can drive a poll.
    public async Task RefreshAsync()
    {
        if (_isRefreshing)
        {
            _refreshQueued = true;
            return;
        }

        _isRefreshing = true;

        try
        {
            do
            {
                _refreshQueued = false;
                await LoadAsync();
            }
            while (_refreshQueued);
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            // The feed shows the newest 20 readings overall, so 20 per sensor is always enough and keeps each poll small.
            var sensorsTask = Http.GetFromJsonAsync<List<SensorProfile>>($"api/sensors?readings={FeedReadingsPerSensor}");
            var insightsTask = Http.GetFromJsonAsync<List<ActionInsight>>("api/insights/suggested");
            var alertsTask = Http.GetFromJsonAsync<List<AlertDetail>>("api/alerts/details");
            var historyTask = Http.GetFromJsonAsync<List<ManualCommand>>("api/commands/history");
            var summaryTask = Http.GetFromJsonAsync<GatewaySummary>("api/summary");
            await Task.WhenAll(sensorsTask, insightsTask, alertsTask, historyTask, summaryTask);

            _sensors = sensorsTask.Result ?? new();
            _insights = insightsTask.Result ?? new();
            _alertDetails = alertsTask.Result ?? new();
            _activeAlertIds = new HashSet<Guid>(_alertDetails.Select(a => a.SensorId));
            _commandHistory = historyTask.Result ?? new();
            _connectionIssues = summaryTask.Result?.ConnectionIssues ?? new();
            _lastSuccessUtc = DateTime.UtcNow;
            _isDisconnected = false;

            var freshIds = ReadingIds(_sensors);
            if (_feedSensors is null)
            {
                // The first snapshot is the baseline; nothing in it counts as newly arrived.
                _feedSensors = _sensors;
                _displayedReadingIds = freshIds;
            }
            else if (_feedPaused)
            {
                _pendingCount = freshIds.Count(id => !_displayedReadingIds.Contains(id));
            }
            else
            {
                ShowLatestInFeed(freshIds);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            // Polling retries on its own; the banner tells the operator, so the error is not rethrown every 3 seconds.
            _isDisconnected = true;
        }
    }

    private void ShowLatestInFeed(HashSet<string> freshIds)
    {
        _newReadingIds.UnionWith(freshIds.Where(id => !_displayedReadingIds.Contains(id)));
        _feedSensors = _sensors;
        _displayedReadingIds = freshIds;
        _pendingCount = 0;
    }

    private void ToggleFeedPause()
    {
        if (_feedPaused)
        {
            _feedPaused = false;
            ShowLatestInFeed(ReadingIds(_sensors ?? new()));
        }
        else
        {
            _feedPaused = true;
            _pendingCount = 0;
        }
    }

    private Guid? DeviceFromQuery()
    {
        var query = new Uri(Navigation.Uri).Query;
        var value = System.Web.HttpUtility.ParseQueryString(query)["device"];
        return Guid.TryParse(value, out var id) ? id : null;
    }

    private void SelectDevice(Guid sensorId)
    {
        _selectedSensorId = sensorId;
        _focusCommandPanel = true;
    }

    private static HashSet<string> ReadingIds(IEnumerable<SensorProfile> sensors) =>
        sensors.SelectMany(s => s.HistoricalTelemetry.Select(r => $"{s.Id}-{r.Timestamp.Ticks}")).ToHashSet();

    public void Dispose()
    {
        _pollTimer?.Dispose();
        _pollTimer = null;
    }
}

@rendermode InteractiveWebAssembly
@page "/dashboard"
@using SmartX.Gateway.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Smart-X | Ingestion</PageTitle>

<div class="section">
    <div class="panel-header">
        <div>
            <h1>Telemetry Dashboard</h1>
            <p>Manage sensor profiles and monitor real-time ingestion.</p>
        </div>
        <div class="filter-chips">
            <button class="ghost-button" @onclick="LoadSensors">Refresh</button>
            @if (sensors is { Count: > 0 })
            {
                <button class="accent-button" @onclick="SeedData">Seed 10 Mock Sensors</button>
            }
        </div>
    </div>

    @if (sensors == null)
    {
        <div class="panel" aria-busy="true">
            <header class="panel-header">
                <h3>Sensor Registry</h3>
                <span class="mono-label">Loading</span>
            </header>
            <div class="empty-state" role="status">Fetching sensor registry...</div>
        </div>
    }
    else if (!sensors.Any())
    {
        <div class="panel">
            <header class="panel-header">
                <h3>Sensor Registry</h3>
                <span class="mono-label">0 sensors</span>
            </header>
            <div class="empty-state">No sensors registered. Seed ten mock sensors to fill the registry and start generating telemetry for the command stream.</div>
            <div>
                <button class="accent-button" @onclick="SeedData">Seed 10 Mock Sensors</button>
            </div>
        </div>
    }
    else
    {
        <div class="command-layout">
            <div class="panel" aria-labelledby="registry-title">
                <header class="panel-header">
                    <h3 id="registry-title">Sensor Registry</h3>
                    <span class="mono-label">@sensors.Count sensors</span>
                </header>
                <div class="data-grid">
                    <div class="data-grid-header">
                        <span>MAC Address</span>
                        <span>Location</span>
                        <span>Category</span>
                        <span>Points</span>
                        <span>Detail</span>
                    </div>

                    @foreach (var sensor in sensors)
                    {
                        <div class="data-grid-row">
                            <span class="data-cell-mac @(selectedSensor?.Id == sensor.Id ? "accent-text" : "")">@sensor.MacAddress</span>
                            <span>@sensor.Location</span>
                            <span><span class="category-badge">@sensor.Category</span></span>
                            <span class="data-cell-value">@sensor.HistoricalTelemetry.Count</span>
                            <span>
                                <button class="ghost-button" @onclick="() => ViewDetails(sensor.Id)">View</button>
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="insights-list">
                @if (selectedSensor != null)
                {
                    <div class="panel" aria-labelledby="detail-title" @key="selectedSensor.Id">
                        <header class="panel-header">
                            <h3 id="detail-title">@selectedSensor.MacAddress</h3>
                            <button class="ghost-button" @onclick="() => selectedSensor = null">Close</button>
                        </header>
                        <span class="mono-label">Last 10 readings</span>
                        @if (selectedSensor.HistoricalTelemetry.Count == 0)
                        {
                            <div class="empty-state">No readings recorded for this sensor yet.</div>
                        }
                        else
                        {
                            <div class="feed-scroll">
                                @foreach (var reading in selectedSensor.HistoricalTelemetry.OrderByDescending(p => p.Timestamp).Take(10))
                                {
                                    <div class="feed-row">
                                        <span class="feed-row-time" style="text-align: left;">@reading.Timestamp.ToString("HH:mm:ss")</span>
                                        <span></span>
                                        <span class="feed-row-value">@reading.Value.ToString("F2")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="command-button-grid">
                    <div class="insight-card">
                        <span class="mono-label">Sensors</span>
                        <h2 class="accent-text">@sensors.Count</h2>
                    </div>
                    <div class="insight-card">
                        <span class="mono-label">Readings</span>
                        <h2>@sensors.Sum(s => s.HistoricalTelemetry.Count)</h2>
                    </div>
                </div>

                <div class="panel" aria-labelledby="breakdown-title">
                    <header class="panel-header">
                        <h3 id="breakdown-title">By Category</h3>
                    </header>
                    <div>
                        @foreach (var category in Enum.GetValues<SensorCategory>())
                        {
                            <div class="feed-row">
                                <span class="feed-row-mac">@category</span>
                                <span></span>
                                <span class="feed-row-value">@sensors.Count(s => s.Category == category)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<SensorProfile>? sensors;
    private SensorProfile? selectedSensor;

    protected override async Task OnInitializedAsync()
    {
        await LoadSensors();
    }

    private async Task LoadSensors()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<SensorProfile>>("api/sensors");
            if (result != null)
            {
                sensors = result;
                selectedSensor = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading sensors: {ex.Message}");
        }
    }

    private async Task SeedData()
    {
        try
        {
            var response = await Http.PostAsync("api/sensors/seed/10", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadSensors();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error seeding data: {ex.Message}");
        }
    }

    private void ViewDetails(Guid sensorId)
    {
        selectedSensor = sensors?.FirstOrDefault(s => s.Id == sensorId);
    }
}